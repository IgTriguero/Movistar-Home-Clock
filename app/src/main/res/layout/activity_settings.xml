<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="16dp"
    android:paddingEnd="32dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:padding="12dp"
            android:text="@string/settings_back"
            android:textColor="#E0A85A"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Rail de secciones -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:background="#121110"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/railGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_general"
                    android:textColor="@color/settings_rail_title"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_general_sub"
                    android:textColor="@color/settings_rail_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/railSports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_settings_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_sports"
                    android:textColor="@color/settings_rail_title"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_sports_sub"
                    android:textColor="@color/settings_rail_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/railWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_settings_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_weather"
                    android:textColor="@color/settings_rail_title"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_weather_sub"
                    android:textColor="@color/settings_rail_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/railInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_settings_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_info"
                    android:textColor="@color/settings_rail_title"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_info_sub"
                    android:textColor="@color/settings_rail_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/railReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_settings_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_report"
                    android:textColor="@color/settings_rail_title"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:duplicateParentState="true"
                    android:text="@string/settings_rail_report_sub"
                    android:textColor="@color/settings_rail_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_rail_footer"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2A2724" />

        <!-- Contenido de la sección seleccionada -->
        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingStart="28dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- General: partidos, noche y fecha de prueba -->
                <LinearLayout
                    android:id="@+id/sectionGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Partidos -->
                    <TextView
                        style="@style/SettingsSectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_matches" />

                    <CheckBox
                        android:id="@+id/showMatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E0A85A"
                        android:text="@string/settings_show_matches"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <!-- Noche -->
                    <TextView
                        style="@style/SettingsSectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_night" />

                    <CheckBox
                        android:id="@+id/nightEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E0A85A"
                        android:text="@string/settings_night_enabled"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_night_start_label"
                                android:textColor="#B0B0B0"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/nightStart"
                                android:importantForAutofill="no"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="#E0A85A"
                                android:hint="@string/settings_night_start_hint"
                                android:inputType="text"
                                android:maxLength="5"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#808080"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <Space
                            android:layout_width="16dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_night_end_label"
                                android:textColor="#B0B0B0"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/nightEnd"
                                android:importantForAutofill="no"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="#E0A85A"
                                android:hint="@string/settings_night_end_hint"
                                android:inputType="text"
                                android:maxLength="5"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#808080"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_night_help"
                        android:textColor="#808080"
                        android:textSize="14sp" />

                    <!-- Fecha de prueba (solo debug) -->
                    <LinearLayout
                        android:id="@+id/testDateSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/SettingsSectionHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_section_test_date" />

                        <EditText
                            android:id="@+id/testDate"
                            android:importantForAutofill="no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#E0A85A"
                            android:hint="@string/settings_test_date_hint"
                            android:inputType="date"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#808080"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Deportes: equipos -->
                <LinearLayout
                    android:id="@+id/sectionSports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SettingsSectionHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_section_teams" />

                        <TextView
                            android:id="@+id/teamListCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="6dp"
                            android:textColor="#A0A0A0"
                            android:textSize="14sp"
                            tools:text="6 / 10 · activos: 5" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_teams_help"
                        android:textColor="#A0A0A0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/teamsReadOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_teams_readonly"
                        android:textColor="#E0A85A"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/teamList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/teamListHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#808080"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="No sigues ningún equipo. El panel de partidos estará oculto."
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/teamListStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="#E0A85A"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Equipo añadido: Real Madrid"
                        tools:visibility="visible" />

                    <Button
                        android:id="@+id/addDefaultTeamsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#555555"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/settings_teams_add_defaults"
                        android:textColor="#FFFFFF"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:labelFor="@id/teamQuery"
                        android:text="@string/settings_team_search_label"
                        android:textColor="#B0B0B0"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/teamQuery"
                        android:importantForAutofill="no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#E0A85A"
                        android:hint="@string/settings_team_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="textCapWords"
                        android:maxLength="60"
                        android:maxLines="1"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#808080"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/teamSearchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#E0A85A"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/settings_team_search"
                        android:textColor="#111111" />

                    <TextView
                        android:id="@+id/teamSearchStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="#E0A85A"
                        android:textSize="15sp"
                        android:visibility="gone"
                        tools:text="Equipos encontrados: 4"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/teamSearchResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/addTeamByIdButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#555555"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/settings_team_by_id"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Tiempo: ciudades y ubicación -->
                <LinearLayout
                    android:id="@+id/sectionWeather"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SettingsSectionHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/settings_section_cities" />

                        <TextView
                            android:id="@+id/cityListCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="6dp"
                            android:textColor="#A0A0A0"
                            android:textSize="14sp"
                            tools:text="2 / 8" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_cities_help"
                        android:textColor="#A0A0A0"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/cityList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/cityListStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="#E0A85A"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Ahora: Vigo"
                        tools:visibility="visible" />

                    <Button
                        android:id="@+id/useLocationButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#555555"
                        android:contentDescription="@string/settings_city_detect_desc"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/settings_city_detect"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/useLocationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="#E0A85A"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_city_detect_help"
                        android:textColor="#808080"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_cities_add_label"
                        android:textColor="#B0B0B0"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/cityQuery"
                        android:importantForAutofill="no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="#E0A85A"
                        android:hint="@string/settings_city_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#808080"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/searchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#E0A85A"
                        android:minHeight="48dp"
                        android:text="@string/settings_search"
                        android:textColor="#111111" />

                    <TextView
                        android:id="@+id/searchStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#E0A85A"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/searchResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Información: diagnóstico y acerca de -->
                <LinearLayout
                    android:id="@+id/sectionInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/SettingsSectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_diagnostics" />

                    <TextView
                        android:id="@+id/diagnosticsMatches"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/diagnosticsWeather"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/diagnosticsSources"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/diagnosticsCache"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/diagnosticsLogos"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/diagnosticsPersisted"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/diagnosticsMemory"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/diagnosticsExit"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/diagnosticsHealth"
                        style="@style/SettingsDiagnostic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        tools:ignore="ButtonStyle">

                        <Button
                            android:id="@+id/refreshNowButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:backgroundTint="#E0A85A"
                            android:minHeight="48dp"
                            android:text="@string/diag_refresh_now"
                            android:textColor="#111111" />

                        <Button
                            android:id="@+id/clearLogosButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#555555"
                            android:minHeight="48dp"
                            android:text="@string/diag_clear_logos"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/diagnosticsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#E0A85A"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <!-- Acerca de -->
                    <TextView
                        style="@style/SettingsSectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_about" />

                    <TextView
                        android:id="@+id/version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#B0B0B0"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_sources"
                        android:textColor="#808080"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/checkUpdatesButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#E0A85A"
                        android:minHeight="48dp"
                        android:text="@string/update_check_button"
                        android:textColor="#111111" />

                    <TextView
                        android:id="@+id/updateStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#E0A85A"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Reportar -->
                <LinearLayout
                    android:id="@+id/sectionReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/SettingsSectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_rail_report" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_report_help"
                        android:textColor="#A0A0A0"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:labelFor="@id/reportPreview"
                        android:text="@string/settings_report_preview_label"
                        android:textColor="#B0B0B0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/reportPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_result"
                        android:padding="12dp"
                        android:textColor="#B0B0B0"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/reportShareButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#E0A85A"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/settings_report_share"
                        android:textColor="#111111" />

                    <Button
                        android:id="@+id/reportCopyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#555555"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:text="@string/settings_report_copy"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/reportStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="#E0A85A"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
