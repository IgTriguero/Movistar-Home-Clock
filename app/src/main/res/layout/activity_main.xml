<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/leftContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                    <TextView
                        android:id="@+id/panelToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="@string/panel_hide"
                        android:textColor="#D0D0D0"
                        android:textSize="14sp"
                        android:letterSpacing="0.08"
                        android:background="@drawable/bg_panel_toggle"
                        android:contentDescription="@string/panel_toggle_desc"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/settingsButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="@string/settings_icon"
                        android:textColor="#808080"
                        android:textSize="26sp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/settings_desc"
                        android:clickable="true"
                        android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="210sp"
                android:letterSpacing="0"
                android:scaleX="1.2"
                android:scaleY="1.2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="72sp"
                android:autoSizeMaxTextSize="250sp"
                android:autoSizeStepGranularity="4sp"
                android:text="@string/clock_placeholder" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0B0B0"
                android:textSize="30sp"
                android:letterSpacing="0.03"
                android:fontFamily="sans-serif-medium"
                android:text="@string/date_placeholder" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.itriguero.homeclock.WeatherPager
                android:id="@+id/weatherPager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.itriguero.homeclock.PageDotsView
                android:id="@+id/weatherDots"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#808080"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/matchPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            android:background="@drawable/bg_match_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/matchPrevDay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/prev_day_icon"
                    android:textColor="#E0A85A"
                    android:textSize="20sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/prev_day_desc"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/matchTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/today"
                    android:textColor="#E0A85A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="22sp"
                    android:autoSizeStepGranularity="1sp" />

                <TextView
                    android:id="@+id/matchNextDay"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/next_day_icon"
                    android:textColor="#E0A85A"
                    android:textSize="20sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next_day_desc"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/matchSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/matches_subtitle"
                android:textColor="#808080"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/matchList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/matchSources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sources_short"
                android:textColor="#808080"
                android:textSize="12sp"
                android:gravity="end"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>
