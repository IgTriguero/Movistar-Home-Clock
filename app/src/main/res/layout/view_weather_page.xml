<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/weatherIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="20dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/weather_icon_placeholder"
            android:textSize="108sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/weatherTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:text="@string/temperature_placeholder"
                    android:textColor="#FFFFFF"
                    android:textSize="88sp" />

                <TextView
                    android:id="@+id/weatherCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxWidth="260dp"
                    android:singleLine="true"
                    android:text="@string/city_placeholder"
                    android:textColor="#808080"
                    android:textSize="30sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/weatherDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="@string/loading"
                android:textColor="#E0E0E0"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/weatherDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:minLines="1"
                android:textColor="#A0A0A0"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
