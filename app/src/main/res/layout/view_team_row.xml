<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_result"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="12dp"
    tools:ignore="ContentDescription">

    <ImageView
        android:id="@+id/teamLogo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_crest_placeholder"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/teamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            tools:text="Real Madrid" />

        <TextView
            android:id="@+id/teamDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#A0A0A0"
            android:textSize="14sp"
            tools:text="LaLiga · España" />

        <TextView
            android:id="@+id/teamBadges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#E0A85A"
            android:textSize="12sp"
            tools:text="Fútbol · En pausa" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/teamEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#E0A85A"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:text="@string/settings_team_follow"
        android:textColor="#E0E0E0"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/teamDelete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/settings_team_delete_symbol"
        android:textColor="#E0E0E0"
        android:textSize="20sp"
        tools:ignore="ContentDescription" />
</LinearLayout>
