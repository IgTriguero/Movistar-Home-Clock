<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de pestaña: activa con tinte y subrayado; inactiva con línea inferior. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/detail_tab_bg_active" />
                </shape>
            </item>
            <item
                android:gravity="bottom"
                android:height="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/detail_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item
                android:gravity="bottom"
                android:height="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/detail_divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
