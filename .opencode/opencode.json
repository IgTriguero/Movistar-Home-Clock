{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
        { "action": "subagent", "resource": "homeclock-coder", "effect": "allow" },
        { "action": "subagent", "resource": "homeclock-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "homeclock-verifier", "effect": "allow" }
      ]
    },
    "subagents/code/coder-agent": { "disabled": true },
    "subagents/code/reviewer": { "disabled": true },
    "subagents/code/build-agent": { "disabled": true },
    "subagents/code/test-engineer": { "disabled": true },
    "subagents/core/contextscout": { "disabled": true }
  }
}
